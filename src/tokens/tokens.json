{
  "primitives": {
    "color": {
      "white": { "$type": "color", "$value": "#ffffff" },
      "gray50": { "$type": "color", "$value": "#f4f6f8" },
      "gray100": { "$type": "color", "$value": "#eef1f4" },
      "gray300": { "$type": "color", "$value": "#d4dae0" },
      "gray600": { "$type": "color", "$value": "#59636e" },
      "gray900": { "$type": "color", "$value": "#17202a" },
      "blue50": { "$type": "color", "$value": "#edf4ff" },
      "blue200": { "$type": "color", "$value": "#9cc2ff" },
      "blue600": { "$type": "color", "$value": "#1859c9" },
      "blue650": { "$type": "color", "$value": "#175cd3" },
      "blue800": { "$type": "color", "$value": "#0f429b" },
      "green50": { "$type": "color", "$value": "#edf8f1" },
      "green700": { "$type": "color", "$value": "#166534" },
      "amber50": { "$type": "color", "$value": "#fff6e8" },
      "amber800": { "$type": "color", "$value": "#8a4b08" },
      "red50": { "$type": "color", "$value": "#fff0ef" },
      "red700": { "$type": "color", "$value": "#b42318" },
      "shadowLow": { "$type": "color", "$value": "#11182714" },
      "shadowMid": { "$type": "color", "$value": "#1118270f" },
      "overlay": { "$type": "color", "$value": "#1118272e" }
    },
    "fontFamily": {
      "ui": { "$type": "fontFamily", "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Consolas", "monospace"] }
    },
    "fontSize": {
      "sm": { "$type": "dimension", "$value": "0.75rem" },
      "md": { "$type": "dimension", "$value": "0.875rem" },
      "lg": { "$type": "dimension", "$value": "1rem" },
      "xl": { "$type": "dimension", "$value": "1.25rem" },
      "2xl": { "$type": "dimension", "$value": "1.625rem" }
    },
    "fontWeight": {
      "regular": { "$type": "number", "$value": 400 },
      "medium": { "$type": "number", "$value": 550 },
      "strong": { "$type": "number", "$value": 700 }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.2 },
      "normal": { "$type": "number", "$value": 1.4 },
      "relaxed": { "$type": "number", "$value": 1.5 }
    },
    "opacity": {
      "disabled": { "$type": "number", "$value": 0.55 }
    },
    "spacing": {
      "1": { "$type": "dimension", "$value": "0.25rem" },
      "2": { "$type": "dimension", "$value": "0.5rem" },
      "3": { "$type": "dimension", "$value": "0.75rem" },
      "4": { "$type": "dimension", "$value": "1rem" },
      "5": { "$type": "dimension", "$value": "1.25rem" },
      "6": { "$type": "dimension", "$value": "1.5rem" },
      "8": { "$type": "dimension", "$value": "2rem" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "0.375rem" },
      "md": { "$type": "dimension", "$value": "0.625rem" },
      "lg": { "$type": "dimension", "$value": "0.875rem" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "borderWidth": {
      "default": { "$type": "dimension", "$value": "1px" },
      "emphasis": { "$type": "dimension", "$value": "2px" },
      "focus": { "$type": "dimension", "$value": "3px" }
    },
    "controlSize": {
      "md": { "$type": "dimension", "$value": "2.25rem" }
    },
    "shadow": {
      "raised": {
        "$type": "shadow",
        "$value": [
          { "color": "{primitives.color.shadowLow}", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
          { "color": "{primitives.color.shadowMid}", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px" }
        ]
      },
      "overlay": {
        "$type": "shadow",
        "$value": { "color": "{primitives.color.overlay}", "offsetX": "0px", "offsetY": "16px", "blur": "48px", "spread": "0px" }
      }
    },
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "normal": { "$type": "duration", "$value": "180ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
    }
  },
  "semantic": {
    "color": {
      "canvas": { "$type": "color", "$value": "{primitives.color.gray50}" },
      "surface": { "$type": "color", "$value": "{primitives.color.white}" },
      "surfaceMuted": { "$type": "color", "$value": "{primitives.color.gray100}" },
      "text": { "$type": "color", "$value": "{primitives.color.gray900}" },
      "textMuted": { "$type": "color", "$value": "{primitives.color.gray600}" },
      "border": { "$type": "color", "$value": "{primitives.color.gray300}" },
      "accent": { "$type": "color", "$value": "{primitives.color.blue600}" },
      "accentStrong": { "$type": "color", "$value": "{primitives.color.blue800}" },
      "focus": { "$type": "color", "$value": "{primitives.color.blue200}" },
      "info": { "$type": "color", "$value": "{primitives.color.blue650}" },
      "infoSurface": { "$type": "color", "$value": "{primitives.color.blue50}" },
      "success": { "$type": "color", "$value": "{primitives.color.green700}" },
      "successSurface": { "$type": "color", "$value": "{primitives.color.green50}" },
      "warning": { "$type": "color", "$value": "{primitives.color.amber800}" },
      "warningSurface": { "$type": "color", "$value": "{primitives.color.amber50}" },
      "danger": { "$type": "color", "$value": "{primitives.color.red700}" },
      "dangerSurface": { "$type": "color", "$value": "{primitives.color.red50}" },
      "overlay": { "$type": "color", "$value": "{primitives.color.overlay}" }
    },
    "typography": {
      "family": { "$type": "fontFamily", "$value": "{primitives.fontFamily.ui}" },
      "monoFamily": { "$type": "fontFamily", "$value": "{primitives.fontFamily.mono}" },
      "sizeSm": { "$type": "dimension", "$value": "{primitives.fontSize.sm}" },
      "sizeMd": { "$type": "dimension", "$value": "{primitives.fontSize.md}" },
      "sizeLg": { "$type": "dimension", "$value": "{primitives.fontSize.lg}" },
      "sizeXl": { "$type": "dimension", "$value": "{primitives.fontSize.xl}" },
      "size2xl": { "$type": "dimension", "$value": "{primitives.fontSize.2xl}" },
      "weightRegular": { "$type": "number", "$value": "{primitives.fontWeight.regular}" },
      "weightMedium": { "$type": "number", "$value": "{primitives.fontWeight.medium}" },
      "weightStrong": { "$type": "number", "$value": "{primitives.fontWeight.strong}" },
      "lineHeightTight": { "$type": "number", "$value": "{primitives.lineHeight.tight}" },
      "lineHeightNormal": { "$type": "number", "$value": "{primitives.lineHeight.normal}" },
      "lineHeightRelaxed": { "$type": "number", "$value": "{primitives.lineHeight.relaxed}" }
    },
    "opacity": {
      "disabled": { "$type": "number", "$value": "{primitives.opacity.disabled}" }
    },
    "spacing": {
      "1": { "$type": "dimension", "$value": "{primitives.spacing.1}" },
      "2": { "$type": "dimension", "$value": "{primitives.spacing.2}" },
      "3": { "$type": "dimension", "$value": "{primitives.spacing.3}" },
      "4": { "$type": "dimension", "$value": "{primitives.spacing.4}" },
      "5": { "$type": "dimension", "$value": "{primitives.spacing.5}" },
      "6": { "$type": "dimension", "$value": "{primitives.spacing.6}" },
      "8": { "$type": "dimension", "$value": "{primitives.spacing.8}" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "{primitives.radius.sm}" },
      "md": { "$type": "dimension", "$value": "{primitives.radius.md}" },
      "lg": { "$type": "dimension", "$value": "{primitives.radius.lg}" },
      "pill": { "$type": "dimension", "$value": "{primitives.radius.pill}" }
    },
    "borderWidth": {
      "default": { "$type": "dimension", "$value": "{primitives.borderWidth.default}" },
      "emphasis": { "$type": "dimension", "$value": "{primitives.borderWidth.emphasis}" },
      "focus": { "$type": "dimension", "$value": "{primitives.borderWidth.focus}" }
    },
    "controlSize": {
      "md": { "$type": "dimension", "$value": "{primitives.controlSize.md}" }
    },
    "elevation": {
      "raised": { "$type": "shadow", "$value": "{primitives.shadow.raised}" },
      "overlay": { "$type": "shadow", "$value": "{primitives.shadow.overlay}" }
    },
    "motion": {
      "fast": { "$type": "duration", "$value": "{primitives.duration.fast}" },
      "normal": { "$type": "duration", "$value": "{primitives.duration.normal}" },
      "ease": { "$type": "cubicBezier", "$value": "{primitives.easing.standard}" }
    }
  }
}
