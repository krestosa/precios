{
  "color": {
    "canvas": { "$type": "color", "$value": "#f4f6f8" },
    "surface": { "$type": "color", "$value": "#ffffff" },
    "surfaceMuted": { "$type": "color", "$value": "#eef1f4" },
    "ink": { "$type": "color", "$value": "#17202a" },
    "inkMuted": { "$type": "color", "$value": "#59636e" },
    "border": { "$type": "color", "$value": "#d4dae0" },
    "accent": { "$type": "color", "$value": "#1859c9" },
    "accentStrong": { "$type": "color", "$value": "#0f429b" },
    "success": { "$type": "color", "$value": "#166534" },
    "warning": { "$type": "color", "$value": "#8a4b08" },
    "danger": { "$type": "color", "$value": "#b42318" },
    "info": { "$type": "color", "$value": "#175cd3" }
  },
  "typography": {
    "family": { "$type": "fontFamily", "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
    "sizeSm": { "$type": "dimension", "$value": "0.75rem" },
    "sizeMd": { "$type": "dimension", "$value": "0.875rem" },
    "sizeLg": { "$type": "dimension", "$value": "1rem" },
    "sizeXl": { "$type": "dimension", "$value": "1.25rem" },
    "size2xl": { "$type": "dimension", "$value": "1.625rem" },
    "weightRegular": { "$type": "number", "$value": 400 },
    "weightMedium": { "$type": "number", "$value": 550 },
    "weightStrong": { "$type": "number", "$value": 700 }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "0.375rem" },
    "md": { "$type": "dimension", "$value": "0.625rem" },
    "lg": { "$type": "dimension", "$value": "0.875rem" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "elevation": {
    "raised": { "$type": "shadow", "$value": "0 1px 2px rgb(17 24 39 / 0.08), 0 8px 24px rgb(17 24 39 / 0.06)" },
    "overlay": { "$type": "shadow", "$value": "0 16px 48px rgb(17 24 39 / 0.18)" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "normal": { "$type": "duration", "$value": "180ms" },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  }
}
